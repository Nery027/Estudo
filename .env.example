# Modelo das variáveis de ambiente. Este arquivo PODE ir para o Git (não tem segredos).
#
# Como usar: copie este arquivo para ".env.local" e preencha com os dados do seu
# projeto Supabase (painel do Supabase > Project Settings > API).
# O ".env.local" NÃO vai para o Git (o .gitignore ignora arquivos *.local).
#
# Use a "Project URL" e a chave pública ("anon public" ou "Publishable key").
# NUNCA use aqui a chave "service_role" (ela dá acesso total ao banco).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
